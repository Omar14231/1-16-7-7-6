local function newPart(name, size, color)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.Color = color or Color3.new(1, 1, 1)
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Parent = visualFolder
    return p
end

local function buildController(name)
    local holder = newPart(name, Vector3.new(0.2, 0.2, 0.2))
    holder.Transparency = 1

    local container = Instance.new("Model")
    container.Name = name .. "_Model"
    local usedMesh = false

    if controllerTemplate then
        local clone = controllerTemplate:Clone()
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("LuaSourceContainer") then d:Destroy() end
        end
        if clone:IsA("LuaSourceContainer") then
            clone:Destroy()
        else
            clone.Parent = container
        end
    end

    if #container:GetDescendants() == 0 then
        local p = Instance.new("Part")
        p.Name = "MeshHand"
        p.Size = Vector3.new(0.5, 0.5, 0.9)
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = "rbxassetid://" .. HAND_MODEL_ID
        mesh.Scale = Vector3.new(HAND_SCALE, HAND_SCALE, HAND_SCALE)
        mesh.Parent = p
        p.Parent = container
        usedMesh = true
    end

    local parts = {}
    for _, d in ipairs(container:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = false
            d.CanCollide = false
            d.CanQuery = false
            d.CanTouch = false
            d.Massless = true
            d.CastShadow = false
            d.Transparency = math.max(d.Transparency, HAND_TRANSPARENCY)
            table.insert(parts, d)
        end
    end

    container.Parent = visualFolder
    if not usedMesh and HAND_SCALE ~= 1 then pcall(function() container:ScaleTo(HAND_SCALE) end) end
    pcall(function() container:PivotTo(holder.CFrame * HAND_OFFSET * HAND_ROTATION) end)

    for _, p in ipairs(parts) do
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = holder
        weld.Part1 = p
        weld.Parent = holder
    end

    local beam = newPart(name .. "_Laser", Vector3.new(LASER_THICKNESS, LASER_THICKNESS, 1), LASER_COLOR)
    beam.Material = Enum.Material.Neon
    beam.Transparency = 1

    local dot = newPart(name .. "_Dot", Vector3.new(0.18, 0.18, 0.18), LASER_COLOR)
    dot.Shape = Enum.PartType.Ball
    dot.Material = Enum.Material.Neon
    dot.Transparency = 1

    return { holder = holder, beam = beam, dot = dot, active = false, lastActive = 0, lastHit = nil, lastTap = 0 }
end

local hands = { Left = buildController("Visual_LeftHand"), Right = buildController("Visual_RightHand") }

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function updateLaser(h, handCF, extended)
    if not extended then
        h.active = false
        h.beam.Transparency = 1
        h.dot.Transparency = 1
        return
    end

    local origin = handCF.Position
    local dir = handCF.LookVector * LASER_MAX
    rayParams.FilterDescendantsInstances = { visualFolder, player.Character }

    local result = Workspace:Raycast(origin, dir, rayParams)
    local endPos = result and result.Position or (origin + dir)
    local len = (endPos - origin).Magnitude
    if len < 0.05 then
        h.beam.Transparency = 1
        h.dot.Transparency = 1
        return
    end

    h.beam.Size = Vector3.new(LASER_THICKNESS, LASER_THICKNESS, len)
    h.beam.CFrame = CFrame.lookAt(origin, endPos) * CFrame.new(0, 0, -len / 2)
    h.beam.Transparency = 0

    h.dot.CFrame = CFrame.new(endPos)
    h.dot.Transparency = result and 0 or 1

    h.active = true
    h.lastActive = os.clock()
    h.lastHit = result and result.Instance or nil
end

-- ==========================================
-- 🎯 نظام النقر الذكي (Smart Interaction Engine)
-- ==========================================
local function triggerObjectInteraction(target)
    if not target then return false end
    local clicked = false

    -- 1. ClickDetector & ProximityPrompt
    local node = target
    while node and node ~= Workspace and not clicked do
        local cd = node:FindFirstChildOfClass("ClickDetector") or node:FindFirstChildWhichIsA("ClickDetector", true)
        if cd and fireclickdetector then
            clicked = pcall(fireclickdetector, cd, 0)
        end

        if not clicked then
            local pp = node:FindFirstChildOfClass("ProximityPrompt") or node:FindFirstChildWhichIsA("ProximityPrompt", true)
            if pp and fireproximityprompt then
                clicked = pcall(fireproximityprompt, pp)
            end
        end
        node = node.Parent
    end

    -- 2. SurfaceGui / BillboardGui Interaction
    if not clicked then
        local sg = target:FindFirstChildWhichIsA("SurfaceGui", true) or target:FindFirstChildWhichIsA("BillboardGui", true) or target.Parent:FindFirstChildWhichIsA("SurfaceGui", true)
        if sg then
            for _, btn in ipairs(sg:GetDescendants()) do
                if btn:IsA("GuiButton") then
                    for _, signal in ipairs({"MouseButton1Click", "MouseButton1Down", "Activated"}) do
                        pcall(function()
                            for _, conn in ipairs(getconnections(btn[signal])) do
                                conn:Fire()
                                clicked = true
                            end
                        end)
                    end
                end
            end
        end
    end

    -- 3. Touch/Physics Hit
    if not clicked and target:IsA("BasePart") then
        pcall(function()
            firetouchinterest(player.Character.HumanoidRootPart, target, 0)
            task.wait(0.05)
            firetouchinterest(player.Character.HumanoidRootPart, target, 1)
            clicked = true
        end)
    end

    return clicked
end

local function farClick(h)
    if os.clock() - h.lastActive > CLICK_GRACE or not h.lastHit then return end
    local target = h.lastHit

    task.spawn(function()
        h.dot.Color = Color3.new(1, 1, 1)
        h.dot.Size = Vector3.new(0.35, 0.35, 0.35)
        task.wait(0.12)
        h.dot.Color = LASER_COLOR
        h.dot.Size = Vector3.new(0.18, 0.18, 0.18)
    end)

    triggerObjectInteraction(target)
end

local function registerTap(handName, inputObj)
    local h = hands[handName]
    local now = os.clock()
    if now - h.lastTap <= DOUBLE_TAP_TIME then
        h.lastTap = 0
        farClick(h)
    else
        h.lastTap = now
    end
end

