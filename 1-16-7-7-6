local function createJoystick(name, anchor, pos, color, isRight)
    local handName = isRight and "Right" or "Left"
    local pad = Instance.new("Frame")
    pad.Size = UDim2.new(0, 170, 0, 170)
    pad.AnchorPoint = anchor
    pad.Position = pos
    pad.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    pad.BackgroundTransparency = 0.35
    pad.Parent = screenGui
    addCorner(pad, 85)
    addStroke(pad, color, 1.5)

    local thumb = Instance.new("ImageButton")
    thumb.Size = UDim2.new(0, 58, 0, 58)
    thumb.Position = UDim2.new(0.5, -29, 0.5, -29)
    thumb.BackgroundColor3 = color
    thumb.BackgroundTransparency = 0.15
    thumb.Parent = pad
    addCorner(thumb, 29)

    if isRight then rightThumbInstance = thumb else leftThumbInstance = thumb end
    local dragging = false
    local activeInput = nil

    local function updateInput(input)
        local center = pad.AbsolutePosition + (pad.AbsoluteSize / 2)
        local delta = Vector2.new(input.Position.X, input.Position.Y) - center
        local maxDist = (pad.AbsoluteSize.X / 2) - 15
        local dist = math.clamp(delta.Magnitude, 0, maxDist)
        local dir = delta.Magnitude > 0 and delta.Unit or Vector2.new(0, 0)
        thumb.Position = UDim2.new(0.5, (-thumb.AbsoluteSize.X / 2) + (dir.X * dist), 0.5, (-thumb.AbsoluteSize.Y / 2) + (dir.Y * dist))
        local moveVec = Vector2.new(dir.X * (dist/maxDist), -dir.Y * (dist/maxDist))
        if isRight then rightJoyMove = moveVec else leftJoyMove = moveVec end
    end

    thumb.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not dragging then
            dragging = true; activeInput = input
            if isRight then rightDragging = true else leftDragging = true end
            registerTap(handName, input); updateInput(input)
        end
    end)
    conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input) if dragging and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseMovement) then updateInput(input) end end)
    conns[#conns + 1] = UserInputService.InputEnded:Connect(function(input) if dragging and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then dragging = false; activeInput = nil; if isRight then rightDragging = false else leftDragging = false end end end)
end

local function createDepthJoystick(name, anchor, pos, color, isRight)
    local handName = isRight and "Right" or "Left"
    local pad = Instance.new("Frame")
    pad.Size = UDim2.new(0, 65, 0, 170)
    pad.AnchorPoint = anchor
    pad.Position = pos
    pad.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    pad.BackgroundTransparency = 0.35
    pad.Parent = screenGui
    addCorner(pad, 12)
    addStroke(pad, color, 1.5)

    local thumb = Instance.new("ImageButton")
    thumb.Size = UDim2.new(0, 50, 0, 36)
    thumb.Position = UDim2.new(0.5, -25, 0.5, -18)
    thumb.BackgroundColor3 = color
    thumb.BackgroundTransparency = 0.15
    thumb.Parent = pad
    addCorner(thumb, 8)

    if isRight then rightZThumbInstance = thumb else leftZThumbInstance = thumb end
    local dragging = false; local activeInput = nil

    local function updateDepth(input)
        local centerY = pad.AbsolutePosition.Y + (pad.AbsoluteSize.Y / 2)
        local maxDist = (pad.AbsoluteSize.Y / 2) - 24
        local clampedY = math.clamp(input.Position.Y - centerY, -maxDist, maxDist)
        thumb.Position = UDim2.new(0.5, -thumb.AbsoluteSize.X / 2, 0.5, (-thumb.AbsoluteSize.Y / 2) + clampedY)
        local intensity = -clampedY / maxDist
        if isRight then rightZMove = intensity else leftZMove = intensity end
    end

    thumb.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not dragging then
            dragging = true; activeInput = input
            if isRight then rightZDragging = true else leftZDragging = true end
            registerTap(handName, input); updateDepth(input)
        end
    end)
    conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input) if dragging and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseMovement) then updateDepth(input) end end)
    conns[#conns + 1] = UserInputService.InputEnded:Connect(function(input) if dragging and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then dragging = false; activeInput = nil; if isRight then rightZDragging = false else leftZDragging = false end end end)
end

