local function scanNexusEnvironment()
    local nexus = ReplicatedStorage:FindFirstChild("NexusVRCharacterModel")
    if not nexus then
        notify("NexusVR Status", "تحذير: لم يتم العثور على 'NexusVRCharacterModel'!", 6)
        return false, nil, nil
    end

    local updateRemote = nexus:FindFirstChild("UpdateInputs")
    local replicationRemote = nexus:FindFirstChild("ReplicationReady")
    if not updateRemote or not replicationRemote then
        notify("NexusVR Status", "تحذير: ملفات الـ RemoteEvents مفقودة!", 6)
        return false, nil, nil
    end

    notify("NexusVR Scanner", "تم ربط نظام Nexus بنجاح ✅", 4)
    return true, updateRemote, replicationRemote
end

