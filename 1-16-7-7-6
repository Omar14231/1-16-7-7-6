    thumb.BackgroundTransparency = 0.15
    thumb.BorderSizePixel = 0
    thumb.Parent = pad
    addCorner(thumb, 8)

    if isRight then rightZThumbInstance = thumb else leftZThumbInstance = thumb end

    local dragging = false
    local activeInput = nil

    local startY = 0
    local startOffsetY = 0

    local function updateDepth(input)
        local maxDist = (pad.AbsoluteSize.Y / 2) - 24
        local clampedY = math.clamp(startOffsetY + (input.Position.Y - startY), -maxDist, maxDist)

        thumb.Position = UDim2.new(0.5, -thumb.AbsoluteSize.X / 2, 0.5, (-thumb.AbsoluteSize.Y / 2) + clampedY)

        local intensity = -clampedY / maxDist
        if isRight then rightZMove = intensity else leftZMove = intensity end
    end

    thumb.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not dragging then
            dragging = true
            activeInput = input
            if isRight then rightZDragging = true else leftZDragging = true end
            local maxDist = (pad.AbsoluteSize.Y / 2) - 24
            local z = isRight and rightZMove or leftZMove
            startOffsetY = -z * maxDist
            startY = input.Position.Y
            registerTap(handName, input)
        end
    end)

    conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input)
        if dragging and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
            updateDepth(input)
        end
    end)

    conns[#conns + 1] = UserInputService.InputEnded:Connect(function(input)
        if dragging and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            activeInput = nil
            if isRight then rightZDragging = false else leftZDragging = false end
            releasedAt[handName .. "Z"] = os.clock()
            releaseGrab(hands[handName])
        end
    end)
end

local function placeThumbXY(thumb, mv)
    if not thumb then return end
    local maxDist = (thumb.Parent.AbsoluteSize.X / 2) - 15
    thumb.Position = UDim2.new(0.5, (-thumb.AbsoluteSize.X / 2) + mv.X * maxDist, 0.5, (-thumb.AbsoluteSize.Y / 2) - mv.Y * maxDist)
end

local function placeThumbZ(thumb, z)
    if not thumb then return end
    local maxDist = (thumb.Parent.AbsoluteSize.Y / 2) - 24
    thumb.Position = UDim2.new(0.5, -thumb.AbsoluteSize.X / 2, 0.5, (-thumb.AbsoluteSize.Y / 2) - z * maxDist)
end

createJoystick("Left", Vector2.new(0, 1), UDim2.new(0, 20, 1, -60), Color3.fromRGB(255, 75, 75), false)
createDepthJoystick("Left", Vector2.new(0, 1), UDim2.new(0, 200, 1, -60), Color3.fromRGB(255, 120, 120), false)
createJoystick("Right", Vector2.new(1, 1), UDim2.new(1, -20, 1, -60), Color3.fromRGB(60, 140, 255), true)
createDepthJoystick("Right", Vector2.new(1, 1), UDim2.new(1, -200, 1, -60), Color3.fromRGB(120, 180, 255), true)

-- ==========================================
-- Core Tracking Loops & VR Kinematics
-- ==========================================
conns[#conns + 1] = RunService.RenderStepped:Connect(function(deltaTime)
    local lerpSpeed = math.clamp(deltaTime * 10, 0.05, 0.25)

    updateVignette(deltaTime)

    -- After release: hold position for RETURN_DELAY, then ease back gradually
    local now = os.clock()
    local ret = math.clamp(deltaTime * 5, 0.02, 0.2)

    if not leftDragging and not activeKeys.LeftArm and now - releasedAt.LeftXY > RETURN_DELAY then
        leftJoyMove = leftJoyMove:Lerp(Vector2.new(0, 0), ret)
        if leftJoyMove.Magnitude < 0.003 then leftJoyMove = Vector2.new(0, 0) end
        placeThumbXY(leftThumbInstance, leftJoyMove)
    end

    if not rightDragging and not activeKeys.RightArm and now - releasedAt.RightXY > RETURN_DELAY then
        rightJoyMove = rightJoyMove:Lerp(Vector2.new(0, 0), ret)
        if rightJoyMove.Magnitude < 0.003 then rightJoyMove = Vector2.new(0, 0) end
        placeThumbXY(rightThumbInstance, rightJoyMove)
    end

    if zAutoCenter then
        if not leftZDragging and now - releasedAt.LeftZ > RETURN_DELAY then
            leftZMove = leftZMove * (1 - ret)
            if math.abs(leftZMove) < 0.003 then leftZMove = 0 end
            placeThumbZ(leftZThumbInstance, leftZMove)
        end
        if not rightZDragging and now - releasedAt.RightZ > RETURN_DELAY then
            rightZMove = rightZMove * (1 - ret)
            if math.abs(rightZMove) < 0.003 then rightZMove = 0 end
            placeThumbZ(rightZThumbInstance, rightZMove)
        end
    end

    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head") then
        local rootCF = char.HumanoidRootPart.CFrame
        local lookX, lookY, lookZ = camera.CFrame:ToEulerAnglesXYZ()

        local headYOffset = 1.5 * currentHeight
        headCF = CFrame.new(rootCF.Position + Vector3.new(0, headYOffset, 0)) * CFrame.Angles(lookX, lookY, lookZ)

        local maxReach = 1.5 * currentHeight
        local armDrop = 0.2

        local leftYPos = math.clamp(armDrop + (leftJoyMove.Y * maxReach), -3.6, 2.5 * maxReach)
        local rightYPos = math.clamp(armDrop + (rightJoyMove.Y * maxReach), -3.6, 2.5 * maxReach)

        local currentZ_Left = math.clamp(-1.2 - (leftZMove * 1.2 * maxReach), -2.6 * maxReach, -0.3)
        local currentZ_Right = math.clamp(-1.2 - (rightZMove * 1.2 * maxReach), -2.6 * maxReach, -0.3)

        local leftVrRoll = math.rad(-leftJoyMove.X * 35) + math.rad(leftZMove * 15)
        local rightVrRoll = math.rad(rightJoyMove.X * 35) - math.rad(rightZMove * 15)

        local leftVrPitch = math.rad((leftJoyMove.Y * 65) + leftTiltPitch) + math.rad(leftZMove * 20)
        local rightVrPitch = math.rad((rightJoyMove.Y * 65) + rightTiltPitch) + math.rad(rightZMove * 20)

        leftHandCF = rootCF
            * CFrame.new(-1.2 + (leftJoyMove.X * maxReach), leftYPos, currentZ_Left)
            * CFrame.Angles(leftVrPitch, math.rad(-leftJoyMove.X * 50), leftVrRoll)

        rightHandCF = rootCF
            * CFrame.new(1.2 + (rightJoyMove.X * maxReach), rightYPos, currentZ_Right)
            * CFrame.Angles(rightVrPitch, math.rad(-rightJoyMove.X * 50), rightVrRoll)

        hands.Left.holder.CFrame = leftHandCF
        hands.Right.holder.CFrame = rightHandCF

        updateLaser(hands.Left, leftHandCF, leftJoyMove.Magnitude > EXTEND_THRESHOLD or leftZMove > EXTEND_THRESHOLD or SETTINGS.LaserAlways)
        updateLaser(hands.Right, rightHandCF, rightJoyMove.Magnitude > EXTEND_THRESHOLD or rightZMove > EXTEND_THRESHOLD or SETTINGS.LaserAlways)

        local currentTime = os.clock()
        if currentTime - lastSendTime >= SEND_INTERVAL and updateInputsRemote then
            lastSendTime = currentTime
            pcall(function() updateInputsRemote:FireServer(headCF, leftHandCF, rightHandCF) end)
        end
    end
end)

conns[#conns + 1] = RunService.Stepped:Connect(function()
    local char = player.Character
    if not char then return end

    local neck = char:FindFirstChild("Neck", true)
    local leftShoulder = char:FindFirstChild("Left Shoulder", true) or char:FindFirstChild("LeftShoulder", true)
    local rightShoulder = char:FindFirstChild("Right Shoulder", true) or char:FindFirstChild("RightShoulder", true)

    if neck and neck.Part0 then
        local targetLocal = neck.Part0.CFrame:ToObjectSpace(headCF)
        neck.Transform = neck.C0:Inverse() * targetLocal * neck.C1
    end
    if leftShoulder and leftShoulder.Part0 then
        local targetLocal = leftShoulder.Part0.CFrame:ToObjectSpace(leftHandCF)
        leftShoulder.Transform = leftShoulder.C0:Inverse() * targetLocal * leftShoulder.C1
    end
    if rightShoulder and rightShoulder.Part0 then
        local targetLocal = rightShoulder.Part0.CFrame:ToObjectSpace(rightHandCF)
        rightShoulder.Transform = rightShoulder.C0:Inverse() * targetLocal * rightShoulder.C1
    end
end)

env.NexusVR_Cleanup = function()
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    for _, h in pairs(hands) do releaseGrab(h) end
    pcall(function() visualFolder:Destroy() end)
    pcall(function() uiFolder:Destroy() end)
    pcall(function() screenGui:Destroy() end)
    pcall(function() vigGui:Destroy() end)
end
