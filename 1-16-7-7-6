-- Joysticks & Depth Sliders (With Double Tap)
-- ==========================================
local leftThumbInstance, rightThumbInstance
local leftZThumbInstance, rightZThumbInstance

local function createJoystick(name, anchor, pos, color, isRight)
    local handName = isRight and "Right" or "Left"
    local pad = Instance.new("Frame")
    pad.Name = name .. "_Pad"
    pad.Size = UDim2.new(0, 170, 0, 170)
    pad.AnchorPoint = anchor
    pad.Position = pos
    pad.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    pad.BackgroundTransparency = 0.35
    pad.BorderSizePixel = 0
    pad.Active = true
    pad.Parent = screenGui
    addCorner(pad, 85)
    addStroke(pad, color, 1.5)

    local thumb = Instance.new("ImageButton")
    thumb.Name = "Thumb"
    thumb.Size = UDim2.new(0, 58, 0, 58)
    thumb.Position = UDim2.new(0.5, -29, 0.5, -29)
    thumb.BackgroundColor3 = color
    thumb.BackgroundTransparency = 0.15
    thumb.BorderSizePixel = 0
    thumb.Parent = pad
    addCorner(thumb, 29)

    if isRight then rightThumbInstance = thumb else leftThumbInstance = thumb end

    local dragging = false
    local activeInput = nil

    local startPos = Vector2.new(0, 0)
    local startOffset = Vector2.new(0, 0)

    -- Relative drag: pressing again keeps the hand exactly where it is,
    -- and moving the finger only adds to the current position.
    local function updateInput(input)
        local maxDist = (pad.AbsoluteSize.X / 2) - 15
        local cur = Vector2.new(input.Position.X, input.Position.Y)
        local off = startOffset + (cur - startPos)
        if off.Magnitude > maxDist then off = off.Unit * maxDist end

        thumb.Position = UDim2.new(0.5, (-thumb.AbsoluteSize.X / 2) + off.X, 0.5, (-thumb.AbsoluteSize.Y / 2) + off.Y)
        local moveVec = Vector2.new(off.X / maxDist, -off.Y / maxDist)

        if isRight then rightJoyMove = moveVec else leftJoyMove = moveVec end
    end

    thumb.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not dragging then
            dragging = true
            activeInput = input
            if isRight then rightDragging = true else leftDragging = true end
            local maxDist = (pad.AbsoluteSize.X / 2) - 15
            local mv = isRight and rightJoyMove or leftJoyMove
            startOffset = Vector2.new(mv.X * maxDist, -mv.Y * maxDist)
            startPos = Vector2.new(input.Position.X, input.Position.Y)
            registerTap(handName, input)
        end
    end)

    conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input)
        if dragging and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
            updateInput(input)
        end
    end)

    conns[#conns + 1] = UserInputService.InputEnded:Connect(function(input)
        if dragging and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            activeInput = nil
            if isRight then rightDragging = false else leftDragging = false end
            releasedAt[handName .. "XY"] = os.clock()
            releaseGrab(hands[handName])
        end
    end)
end

