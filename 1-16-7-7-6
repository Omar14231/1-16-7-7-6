-- ==========================================
-- Grab (physics, held while finger stays down after double tap)
-- ==========================================
local function releaseGrab(h)
    local g = h.grab
    if not g then return end
    h.grab = nil
    pcall(function() g.pos:Destroy() end)
    pcall(function() g.rot:Destroy() end)
    pcall(function() g.att0:Destroy() end)
    pcall(function() g.att1:Destroy() end)
end

local function startGrab(h, target, point)
    releaseGrab(h)
    local att0 = Instance.new("Attachment")
    att0.WorldCFrame = CFrame.new(point or target.Position)
    att0.Parent = target

    local att1 = Instance.new("Attachment")
    att1.CFrame = h.holder.CFrame:ToObjectSpace(att0.WorldCFrame)
    att1.Parent = h.holder

    local pos = Instance.new("AlignPosition")
    pos.Mode = Enum.PositionAlignmentMode.TwoAttachment
    pos.Attachment0 = att0
    pos.Attachment1 = att1
    pos.MaxForce = math.huge
    pos.MaxVelocity = math.huge
    pos.Responsiveness = 50
    pos.Parent = target

    local rot = Instance.new("AlignOrientation")
    rot.Mode = Enum.OrientationAlignmentMode.TwoAttachment
    rot.Attachment0 = att0
    rot.Attachment1 = att1
    rot.MaxTorque = math.huge
    rot.MaxAngularVelocity = math.huge
    rot.Responsiveness = 50
    rot.Parent = target

    h.grab = { att0 = att0, att1 = att1, pos = pos, rot = rot }
end

-- ==========================================
-- Smart Interaction Engine
-- ==========================================
local function triggerObjectInteraction(target, allowTouch)
    if not target then return false end
    local clicked = false

    local node = target
    while node and node ~= Workspace and not clicked do
        local cd = node:FindFirstChildOfClass("ClickDetector") or node:FindFirstChildWhichIsA("ClickDetector", true)
        if cd and fireclickdetector then
            clicked = pcall(fireclickdetector, cd, 0)
        end

        if not clicked then
            local pp = node:FindFirstChildOfClass("ProximityPrompt") or node:FindFirstChildWhichIsA("ProximityPrompt", true)
            if pp and fireproximityprompt then
                clicked = pcall(fireproximityprompt, pp)
            end
        end
        node = node.Parent
    end

    if not clicked then
        local sg = target:FindFirstChildWhichIsA("SurfaceGui", true) or target:FindFirstChildWhichIsA("BillboardGui", true) or (target.Parent and target.Parent:FindFirstChildWhichIsA("SurfaceGui", true))
        if sg and getconnections then
            for _, btn in ipairs(sg:GetDescendants()) do
                if btn:IsA("GuiButton") then
                    for _, signal in ipairs({"MouseButton1Click", "MouseButton1Down", "Activated"}) do
                        pcall(function()
                            for _, conn in ipairs(getconnections(btn[signal])) do
                                conn:Fire()
                                clicked = true
                            end
                        end)
                    end
                end
            end
        end
    end

    if not clicked and allowTouch and target:IsA("BasePart") and firetouchinterest then
        pcall(function()
            firetouchinterest(player.Character.HumanoidRootPart, target, 0)
            task.wait(0.05)
            firetouchinterest(player.Character.HumanoidRootPart, target, 1)
            clicked = true
        end)
    end

    return clicked
end

local function flashDot(h)
    task.spawn(function()
        h.dot.Color = Color3.new(1, 1, 1)
        h.dot.Size = Vector3.new(0.35, 0.35, 0.35)
        task.wait(0.12)
        h.dot.Color = LASER_COLOR
        h.dot.Size = Vector3.new(0.18, 0.18, 0.18)
    end)
end

local function farClick(h)
    if os.clock() - h.lastActive > CLICK_GRACE or not h.lastHit then return end
    local target = h.lastHit
    local point = h.lastPoint

    flashDot(h)

    local grabbable = SETTINGS.Grab and target:IsA("BasePart") and not target.Anchored
    task.spawn(function()
        triggerObjectInteraction(target, not grabbable)
    end)
    if grabbable then
        startGrab(h, target, point)
    end
end

local function registerTap(handName, inputObj)
    local h = hands[handName]
    local now = os.clock()
    if now - h.lastTap <= DOUBLE_TAP_TIME then
        h.lastTap = 0
        farClick(h)
    else
        h.lastTap = now
    end
end

