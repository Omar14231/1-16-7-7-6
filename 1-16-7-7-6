rayParams.IgnoreWater = true

local uiRayParams = RaycastParams.new()
uiRayParams.FilterType = Enum.RaycastFilterType.Include
uiRayParams.IgnoreWater = true

local function updateLaser(h, handCF, extended)
    if not extended then
        h.active = false
        h.beam.Transparency = 1
        h.dot.Transparency = 1
        return
    end

    local origin = handCF.Position
    local dir = handCF.LookVector * LASER_MAX
    rayParams.FilterDescendantsInstances = { visualFolder, player.Character }

    uiRayParams.FilterDescendantsInstances = { uiFolder }
    local result = Workspace:Raycast(origin, dir, uiRayParams) or Workspace:Raycast(origin, dir, rayParams)
    local endPos = result and result.Position or (origin + dir)
    local len = (endPos - origin).Magnitude
    if len < 0.05 then
        h.beam.Transparency = 1
        h.dot.Transparency = 1
        return
    end

    h.beam.Color = LASER_COLOR
    h.beam.Size = Vector3.new(SETTINGS.LaserThickness, SETTINGS.LaserThickness, len)
    h.beam.CFrame = CFrame.lookAt(origin, endPos) * CFrame.new(0, 0, -len / 2)
    h.beam.Transparency = 0

    h.dot.CFrame = CFrame.new(endPos)
    h.dot.Transparency = result and 0 or 1

    h.active = true
    h.lastActive = os.clock()
    h.lastHit = result and result.Instance or nil
    h.lastPoint = result and result.Position or nil
end

