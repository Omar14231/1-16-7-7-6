local function scanEnvironmentDynamically()
    local updateRemote = nil
    local replicationRemote = nil

    local searchContainers = {ReplicatedStorage, Workspace}
    for _, container in ipairs(searchContainers) do
        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                local name = string.lower(obj.Name)
                if name == "updateinputs" or string.find(name, "vrinput") or string.find(name, "updatehands") then
                    updateRemote = obj
                elseif name == "replicationready" or name == "readystate" or string.find(name, "vrready") then
                    replicationRemote = obj
                end
            end
        end
    end

    if not updateRemote then
        notify("VR Scanner", "لم يتم العثور على RemoteEvents. قد يكون الماب محمي بشدة.", 6)
        return false, nil, nil
    end

    notify("VR Scanner", "تم اكتشاف ملفات الـ VR وربط التحكم بنجاح ✅", 4)
    return true, updateRemote, replicationRemote
end

local isFE, updateInputsRemote, replicationReadyRemote = scanEnvironmentDynamically()
