conns[#conns + 1] = RunService.RenderStepped:Connect(function(deltaTime)
    local lerpSpeed = math.clamp(deltaTime * 10, 0.05, 0.25)

    if not leftDragging then
        leftJoyMove = leftJoyMove:Lerp(Vector2.new(0, 0), lerpSpeed)
        if leftThumbInstance then leftThumbInstance.Position = leftThumbInstance.Position:Lerp(UDim2.new(0.5, -29, 0.5, -29), lerpSpeed) end
    end
    if not rightDragging then
        rightJoyMove = rightJoyMove:Lerp(Vector2.new(0, 0), lerpSpeed)
        if rightThumbInstance then rightThumbInstance.Position = rightThumbInstance.Position:Lerp(UDim2.new(0.5, -29, 0.5, -29), lerpSpeed) end
    end

    if zAutoCenter then
        if not leftZDragging then
            leftZMove = math.clamp(leftZMove * (1 - lerpSpeed), 0, 1)
            if leftZThumbInstance then leftZThumbInstance.Position = leftZThumbInstance.Position:Lerp(UDim2.new(0.5, -25, 0.5, -18), lerpSpeed) end
        end
        if not rightZDragging then
            rightZMove = math.clamp(rightZMove * (1 - lerpSpeed), 0, 1)
            if rightZThumbInstance then rightZThumbInstance.Position = rightZThumbInstance.Position:Lerp(UDim2.new(0.5, -25, 0.5, -18), lerpSpeed) end
        end
    end

    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head") then
        local rootCF = char.HumanoidRootPart.CFrame
        local lookX, lookY, lookZ = camera.CFrame:ToEulerAnglesXYZ()
        headCF = CFrame.new(rootCF.Position + Vector3.new(0, 1.5 * currentHeight, 0)) * CFrame.Angles(lookX, lookY, lookZ)

        local maxReach = 1.5 * currentHeight
        local leftYPos = math.clamp(0.2 + (leftJoyMove.Y * maxReach), -3.6, 2.5 * maxReach)
        local rightYPos = math.clamp(0.2 + (rightJoyMove.Y * maxReach), -3.6, 2.5 * maxReach)
        local currentZ_Left = math.clamp(-1.2 - (leftZMove * 1.2 * maxReach), -2.6 * maxReach, -0.3)
        local currentZ_Right = math.clamp(-1.2 - (rightZMove * 1.2 * maxReach), -2.6 * maxReach, -0.3)

        leftHandCF = rootCF * CFrame.new(-1.2 + (leftJoyMove.X * maxReach), leftYPos, currentZ_Left) * CFrame.Angles(math.rad(leftJoyMove.Y * 65 + leftZMove * 20), math.rad(-leftJoyMove.X * 50), math.rad(-leftJoyMove.X * 35 + leftZMove * 15))
        rightHandCF = rootCF * CFrame.new(1.2 + (rightJoyMove.X * maxReach), rightYPos, currentZ_Right) * CFrame.Angles(math.rad(rightJoyMove.Y * 65 + rightZMove * 20), math.rad(-rightJoyMove.X * 50), math.rad(rightJoyMove.X * 35 - rightZMove * 15))

        hands.Left.holder.CFrame = leftHandCF
        hands.Right.holder.CFrame = rightHandCF

        updateLaser(hands.Left, leftHandCF, leftJoyMove.Magnitude > EXTEND_THRESHOLD or leftZMove > EXTEND_THRESHOLD)
        updateLaser(hands.Right, rightHandCF, rightJoyMove.Magnitude > EXTEND_THRESHOLD or rightZMove > EXTEND_THRESHOLD)

        local currentTime = os.clock()
        if currentTime - lastSendTime >= SEND_INTERVAL and updateInputsRemote then
            lastSendTime = currentTime
            pcall(function() updateInputsRemote:FireServer(headCF, leftHandCF, rightHandCF) end)
        end
    end
end)

env.NexusVR_Cleanup = function()
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(function() visualFolder:Destroy() end)
    pcall(function() screenGui:Destroy() end)
end
