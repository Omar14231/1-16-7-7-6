local function newPart(name, size, color, parent)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.Color = color or Color3.new(1, 1, 1)
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Parent = parent or visualFolder
    return p
end

local function buildController(name)
    local holder = newPart(name, Vector3.new(0.2, 0.2, 0.2))
    holder.Transparency = 1

    local container = Instance.new("Model")
    container.Name = name .. "_Model"
    local usedMesh = false

    if controllerTemplate then
        local clone = controllerTemplate:Clone()
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("LuaSourceContainer") then d:Destroy() end
        end
        if clone:IsA("LuaSourceContainer") then
            clone:Destroy()
        else
            clone.Parent = container
        end
    end

    if #container:GetDescendants() == 0 then
        local p = Instance.new("Part")
        p.Name = "MeshHand"
        p.Size = Vector3.new(0.5, 0.5, 0.9)
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = "rbxassetid://" .. HAND_MODEL_ID
        mesh.Scale = Vector3.new(HAND_SCALE, HAND_SCALE, HAND_SCALE)
        mesh.Parent = p
        p.Parent = container
        usedMesh = true
    end

    local parts = {}
    for _, d in ipairs(container:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = false
            d.CanCollide = false
            d.CanQuery = false
            d.CanTouch = false
            d.Massless = true
            d.CastShadow = false
            d.Transparency = SETTINGS.HandTransparency
            table.insert(parts, d)
        end
    end

    container.Parent = visualFolder
    if not usedMesh and HAND_SCALE ~= 1 then pcall(function() container:ScaleTo(HAND_SCALE) end) end
    pcall(function() container:PivotTo(holder.CFrame * HAND_OFFSET * HAND_ROTATION) end)

    for _, p in ipairs(parts) do
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = holder
        weld.Part1 = p
        weld.Parent = holder
    end

    local beam = newPart(name .. "_Laser", Vector3.new(SETTINGS.LaserThickness, SETTINGS.LaserThickness, 1), LASER_COLOR)
    beam.Material = Enum.Material.Neon
    beam.Transparency = 1

    local dot = newPart(name .. "_Dot", Vector3.new(0.18, 0.18, 0.18), LASER_COLOR)
    dot.Shape = Enum.PartType.Ball
    dot.Material = Enum.Material.Neon
    dot.Transparency = 1

    return {
        holder = holder, beam = beam, dot = dot, parts = parts,
        active = false, lastActive = 0, lastHit = nil, lastPoint = nil, lastTap = 0,
        grab = nil, -- { att0, att1, pos, rot }
    }
end

